    "tags":  [
                 {
                     "name":  "Products",
                     "description":  "Product catalog backed by MongoDB. Reads are public through the gateway; creating a product requires the ADMIN realm role. Authorization is enforced at the gateway, not on the direct service port."
                 },
                 {
                     "name":  "Orders",
                     "description":  "Order placement backed by SQL Server with inventory lookup and Kafka publication to notificationTopic. Requires USER or ADMIN through the gateway. Demo limitations: prices come from the request, stock is not reserved, and a fallback can return HTTP 201 with a failure message. Not a production checkout."
                 },
                 {
                     "name":  "Inventory (Internal)",
                     "description":  "Internal SKU stock lookup backed by SQL Server. Reference only in the combined gateway documentation; no gateway business route is exposed."
                 }
             ]
